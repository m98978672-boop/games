{
  "name": "truck-showroom-3d",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "3D-шоурум техники: 10 тягачей, 20 прицепов, 10 автомобилей — снаружи и в салоне",
  "scripts": {
    "build": "esbuild src/app.js --bundle --minify --format=iife --target=es2019 --outfile=showroom.bundle.js",
    "serve": "node tools/serve.mjs",
    "test": "node tests/smoke.mjs && node tests/seams.mjs && node tests/ui.mjs",
    "render": "node tools/render.mjs",
    "seams": "node tools/seams.mjs"
  },
  "dependencies": {
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "esbuild": "^0.25.0",
    "jsdom": "^25.0.1",
    "pngjs": "^7.0.0"
  }
}
