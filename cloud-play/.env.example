# Copy to .env. Never commit the real .env file.
PORT=4174
# Local test:
PUBLIC_ORIGIN=http://localhost:4174
# Production: replace PLAYBRIDGE_DOMAIN and set PUBLIC_ORIGIN=https://<your-domain>.
PLAYBRIDGE_DOMAIN=playbridge.example
# Generate with: openssl rand -hex 32
SESSION_SECRET=CHANGE-ME
# Steam Web API key stays on the server; never put it in browser code.
STEAM_WEB_API_KEY=
# Optional Dropbox App: App Folder access, scopes files.content.read + files.content.write.
# Register https://<your-domain>/auth/dropbox/callback as its OAuth redirect URI.
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
# Generate a separate secret with: openssl rand -hex 32
DROPBOX_TOKEN_SECRET=CHANGE-ME
NODE_ENV=development
