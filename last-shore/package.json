{
  "name": "last-shore",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LAST SHORE — 3D survival game (Three.js), one island, one life",
  "scripts": {
    "build": "esbuild src/main.js --bundle --format=iife --target=es2019 --outfile=bundle.js",
    "dev": "esbuild src/main.js --bundle --format=iife --target=es2019 --sourcemap --outfile=bundle.js --watch",
    "serve": "python3 -m http.server 8080 --bind 0.0.0.0"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "jsdom": "^30.1.3"
  }
}
