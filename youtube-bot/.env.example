# Local web address. Must match the OAuth redirect URI in Google Cloud.
PUBLIC_BASE_URL=http://localhost:8765
# Optional location for the private token, queue, and video files.
DATA_DIR=data
# Required for an HTTPS/public preview; choose long random values.
# APP_ACCESS_PASSWORD=replace-with-a-long-random-password
# APP_SESSION_SECRET=replace-with-another-long-random-secret
# If your downloaded OAuth JSON has another filename/path:
# GOOGLE_CLIENT_SECRETS_FILE=/absolute/path/to/client_secret.json
