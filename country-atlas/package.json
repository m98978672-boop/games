{
  "name": "atlas-ratgrad",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "АТЛАС РАТГРАДА — интерактивная 3D-карта вымышленной страны: рельеф, дороги, города, границы, транспорт и локальный ИИ",
  "scripts": {
    "catalog": "node tools/gen-catalog.mjs",
    "test:catalog": "node tests/catalog.mjs",
    "build": "esbuild src/main.js --bundle --minify --format=iife --target=es2019 --outfile=atlas.bundle.js",
    "dev": "esbuild src/main.js --bundle --format=iife --target=es2019 --outfile=atlas.bundle.js --watch",
    "serve": "python3 -m http.server 8080 --bind 0.0.0.0",
    "routines": "node tools/gen-routines.mjs",
    "test:routines": "node tests/routines.mjs",
    "test": "node tests/catalog.mjs && node tests/routines.mjs && node tests/demo.mjs && node tests/equations.mjs && node tests/equations-demo.mjs && node tests/ai-formulas.mjs && node tests/ai-demo.mjs",
    "demo": "node tools/build-routines-demo.mjs",
    "test:demo": "node tests/demo.mjs",
    "demo:eq": "node tools/build-routines-demo.mjs equations",
    "test:equations": "node tests/equations.mjs",
    "test:equations-demo": "node tests/equations-demo.mjs",
    "ai:doc": "node tools/gen-ai-doc.mjs",
    "test:ai": "node tests/ai-formulas.mjs",
    "test:ai-demo": "node tests/ai-demo.mjs"
  },
  "dependencies": {
    "three": "^0.186.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "jsdom": "^26.0.0"
  }
}
