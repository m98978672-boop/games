; СЕКТОР «ПЕПЕЛ» — Godot 4 port
; Все модели, карты, звук и анимации генерируются кодом: внешних ассетов нет.

config_version=5

[application]

config/name="СЕКТОР «ПЕПЕЛ»"
config/description="Тактический шутер: 1760 анимаций, боевики «больно думают», кукла из точек. Геометрия строится по обведённым контурам."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/vsync/vsync_mode=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=1

[physics]

common/physics_ticks_per_second=60

