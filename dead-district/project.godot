; DEAD DISTRICT — Pixel-Art 2D+3D Survival Sandbox (Godot 4.3+)
; Палитра: Survival Horror 32 (Lospec). Внутреннее разрешение рендера 480x270 -> x4 nearest (1920x1080).

config_version=5

[application]

config/name="DEAD DISTRICT"
config/description="Изометрическая survival-sandbox игра про выживание в зомби-апокалипсисе: 2D пиксель-арт + 3D low-poly окружение через SubViewport 480x270 (x4 nearest), 15 систем выживания, Utility AI и FSM-зомби."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

ErrorManager="*res://scripts/core/error_manager.gd"
EventBus="*res://scripts/core/event_bus.gd"
DataDB="*res://scripts/core/data_db.gd"
SaveManager="*res://scripts/core/save_manager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/vsync/vsync_mode=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
textures/default_filters/use_nearest_mipmap_filter=true
anti_aliasing/quality/msaa_2d=0
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=0

[physics]

common/physics_ticks_per_second=60

[input]

