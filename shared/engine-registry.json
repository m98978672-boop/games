{
  "schema": "games-engine-registry/1",
  "engine": {
    "name": "RatCore",
    "version": "1.0.0",
    "entry": "ratcore/ratcore.bundle.js",
    "builder": "ratcore/tools/build-browser-bundle.mjs",
    "bridge": "shared/engine.js",
    "bootstrap": "shared/engine-bootstrap.js",
    "modules": 48
  },
  "rules": [
    "Каждый раздел Games подключает движок через ../shared/engine.js (или shared/engine.js в корне).",
    "move_engine_js подключается ДО игровых скриптов, bootstrap — после.",
    "Новый раздел без строки подключения не пройдёт тест game-base/tests/engine.mjs.",
    "Движок работает и с file://: это классический скрипт, без type=module."
  ],
  "sections": [
    {
      "id": "storefront",
      "path": "index.html",
      "kind": "portal",
      "engine": "shared/engine.js",
      "badge": "footer",
      "note": "Витрина Games: пункт «⚙️ Движок» в ленте + версия в футере"
    },
    {
      "id": "news",
      "path": "news/index.html",
      "kind": "department",
      "engine": "../shared/engine.js",
      "badge": "auto",
      "note": "Отдел новостей Games News"
    },
    {
      "id": "ratmes",
